# AI-CHA – Environment variables
#
# Copy this file to .env in the project root and fill in your real values.
# Never commit the actual .env file to version control.
#
#   cp .env.example .env

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model to use for chat completions (optional, default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# ── Alternative providers (uncomment and fill in as needed) ─────────────────

# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini
# GOOGLE_API_KEY=your-google-api-key-here

# Groq
# GROQ_API_KEY=your-groq-api-key-here
